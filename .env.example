# Основные настройки приложения
APP_NAME="IT Department Workflow System"
APP_ENV=local
APP_DEBUG=true

# PostgreSQL для локального запуска через docker compose
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tihon_diplom
POSTGRES_USER=tihon_user
POSTGRES_PASSWORD=tihon_password

# SQLAlchemy использует эту строку подключения внутри контейнера приложения
DATABASE_URL=postgresql+psycopg2://tihon_user:tihon_password@db:5432/tihon_diplom

# Настройки JWT. В реальной эксплуатации SECRET_KEY нужно заменить и не хранить в репозитории.
SECRET_KEY=change-this-local-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Токен для защиты тестового webhook Zabbix в локальной среде.
ZABBIX_WEBHOOK_TOKEN=local-zabbix-token

# MinIO для файловых вложений.
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=local-access-key
MINIO_SECRET_KEY=local-secret-key
MINIO_BUCKET=task-attachments
MINIO_SECURE=false
